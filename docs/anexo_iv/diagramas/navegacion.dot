digraph navegacion {
  graph [rankdir=TB, fontname="Helvetica", fontsize=12, nodesep=0.4, ranksep=0.45, bgcolor="white", pad=0.2, dpi=200];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="#D9EAE9", color="#0E5A62", penwidth=1.3];
  edge  [color="#0E5A62", penwidth=1.1, arrowsize=0.7, fontname="Helvetica", fontsize=9];
  menu [label="menu\nMenuScreen", fillcolor="#0E5A62", fontcolor="white"];
  imp [label="Diálogo «Importar partitura»\nabrir_selector_de_archivo", shape=note, fillcolor="#F4F2EE"];
  elegir [label="elegir_partitura\nElegirPartituraScreen"];
  prep [label="ajustes_inicio\nAjustesInicioScreen"];
  inter [label="interprete\nInterpreteScreen"];
  simple [label="partitura_simple\nPartituraSimpleScreen"];
  ajustes [label="ajustes\nAjustesScreen"];
  prog [label="progreso\nProgresoScreen"];
  fin [label="Diálogo «Práctica terminada»\n_mostrar_resumen_final", shape=note, fillcolor="#F4F2EE"];
  menu -> imp [label="Importar"];
  elegir -> imp [label="Importar otra"];
  imp -> prep [label="Abrir"];
  menu -> elegir [label="Mis partituras"];
  menu -> prep [label="Continuar"];
  elegir -> prep [label="elegir partitura"];
  menu -> prog [label="Progreso"];
  menu -> ajustes [label="Ajustes / engranaje"];
  prep -> inter [label="Practicar (vista pentagrama)"];
  prep -> simple [label="Practicar (vista simplificada)"];
  inter -> simple [dir=both, label="alternar vista"];
  inter -> fin [label="sesión terminada"];
  simple -> fin [label="sesión terminada"];
  fin -> prog [label="Ver progreso"];
  fin -> inter [label="Repetir", style=dashed];
  inter -> prep [label="Atrás (confirma si escucha)", style=dashed];
}
